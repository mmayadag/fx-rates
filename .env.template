# Required
DB_USER=USERNAME
DB_PASSWORD=PASSWORD
DB_NAME=DATABASE
DB_HOST=HOST
DB_PORT=5432

# Optional: use require in production
DB_SSLMODE=disable

# Backward-compatible fallback if you prefer a single DSN instead
# DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=disable

# Optional tuning
DB_MAX_CONNECTIONS=10
BACKFILL_CONCURRENCY=10
DEBUG=false

# SYNC_MODE: full (default) or daily_sync
# daily_sync is the recurring ECB refresh mode
SYNC_MODE=full

# DAILY_SYNC_TIMEOUT: max duration for the sync job
# Default when SYNC_MODE=full: 6h
# Default when SYNC_MODE=daily_sync: 30m
# Override it only when you intentionally need a different limit
DAILY_SYNC_TIMEOUT=

DEBUG_HEARTBEAT_INTERVAL=30s

# Apply database migrations on startup
# Default: true. Set to false in production to manage migrations out-of-band.
RUN_MIGRATIONS=true

# LOG_LEVEL: debug, info, warn, error
# Optional. When unset, falls back to debug if DEBUG=true, else info.
# LOG_LEVEL=info

# fx-rates configuration template.
# Copy to .env and edit the values below.

# ─── Required: database connection ─────────────────────────────────────
DB_USER=USERNAME
DB_PASSWORD=PASSWORD
DB_NAME=DATABASE
DB_HOST=HOST
DB_PORT=5432

# "require" encrypts but does NOT verify the server cert. Against an untrusted
# network use "verify-full" (authenticates the server, blocks MITM) and supply
# the CA via sslrootcert in DATABASE_URL. Use "disable" only for local TLS-less Postgres.
DB_SSLMODE=require

# Backward-compatible fallback if you prefer a single DSN.
# DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=disable

# ─── Sync mode ─────────────────────────────────────────────────────────
# full        — historical backfill (initial seeding or recovery)
# daily_sync  — recurring ECB refresh (production cron)
SYNC_MODE=full

# Max duration for the sync job.
# Default when SYNC_MODE=full: 6h
# Default when SYNC_MODE=daily_sync: 30m
# Leave empty to use the mode default; set explicitly only to override.
DAILY_SYNC_TIMEOUT=

# Max look-back window in daily_sync mode. Caps how far back the run may reach
# if `last_synced` lags (e.g. recovering after an outage). 0 disables the cap.
# Default: 7
# DAILY_SYNC_LOOKBACK_DAYS=7

# ─── Connection pool ───────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10

# DB pool extras (defaults shown). Uncomment to override.
# DB_MIN_CONNECTIONS=5
# DB_MAX_CONN_LIFETIME=30m
# DB_MAX_CONN_IDLE_TIME=5m
# DB_HEALTH_CHECK_PERIOD=30s

# Max bytes the ECB CSV scanner will accept per line. ECB daily CSV is ~100KB;
# the 10MB default is generous headroom. Bump only if ECB ever ships
# substantially larger payloads. Default: 10485760.
# ECB_MAX_RESPONSE_BYTES=10485760

# ─── Migrations ────────────────────────────────────────────────────────
# Apply database migrations on startup. Set to false in production to
# manage migrations out-of-band.
RUN_MIGRATIONS=true

# ─── Logging / diagnostics ─────────────────────────────────────────────
# DEBUG only gates scheduler heartbeat logs; it no longer affects log level.
DEBUG=false

# LOG_LEVEL: debug, info, warn, error. Defaults to info when unset.
# LOG_LEVEL=info

DEBUG_HEARTBEAT_INTERVAL=30s

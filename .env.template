# fx-rates configuration template.
# Copy to .env and edit the values below.

# ─── Required: database connection ─────────────────────────────────────
DB_USER=USERNAME
DB_PASSWORD=PASSWORD
DB_NAME=DATABASE
DB_HOST=HOST
DB_PORT=5432

# Use require in production. disable is fine for local Postgres.
DB_SSLMODE=disable

# Backward-compatible fallback if you prefer a single DSN.
# DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=disable

# ─── Sync mode ─────────────────────────────────────────────────────────
# full        — historical backfill (initial seeding or recovery)
# daily_sync  — recurring ECB refresh (production cron)
SYNC_MODE=full

# Max duration for the sync job.
# Default when SYNC_MODE=full: 6h
# Default when SYNC_MODE=daily_sync: 30m
# Leave empty to use the mode default; set explicitly only to override.
DAILY_SYNC_TIMEOUT=

# ─── Pool & concurrency ────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10
BACKFILL_CONCURRENCY=10

# DB pool extras (defaults shown). Uncomment to override.
# DB_MIN_CONNECTIONS=5
# DB_MAX_CONN_LIFETIME=30m
# DB_MAX_CONN_IDLE_TIME=5m
# DB_HEALTH_CHECK_PERIOD=30s

# ─── Migrations ────────────────────────────────────────────────────────
# Apply database migrations on startup. Set to false in production to
# manage migrations out-of-band.
RUN_MIGRATIONS=true

# ─── Logging / diagnostics ─────────────────────────────────────────────
DEBUG=false

# LOG_LEVEL: debug, info, warn, error
# When unset, falls back to debug if DEBUG=true, else info.
# LOG_LEVEL=info

DEBUG_HEARTBEAT_INTERVAL=30s
